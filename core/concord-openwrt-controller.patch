index 0000000..8764c9b
--- /dev/null
+++ b/crates/controller/src/openwrt.rs
@@ -0,0 +1,669 @@
+//! Dashboard and selection storage for Concord's OpenWrt standalone controller.
+
+use std::collections::BTreeMap;
+use std::io::{self, Read, Write};
+use std::net::IpAddr;
+use std::os::unix::fs::{FileTypeExt, MetadataExt, PermissionsExt};
+use std::path::{Component, Path, PathBuf};
+use std::sync::Arc;
+
+use concord_api::{Control, ControllerCors, Origin};
+use concord_common::Tasks;
+use concord_proto::types::ProxySelectParams;
+use futures_util::StreamExt;
+use http::{Method, Request, Response, StatusCode, header};
+use http_body_util::{BodyExt, StreamBody};
+use hyper::body::{Frame, Incoming};
+use rustls_pki_types::{CertificateDer, PrivateKeyDer, pem::PemObject};
+use serde::Deserialize;
+use tokio::{
+    net::{TcpListener, UnixListener, UnixStream},
+    sync::Mutex,
+    time,
+};
+use tokio_rustls::TlsAcceptor;
+use tokio_util::{io::ReaderStream, sync::CancellationToken, task::TaskTracker};
+
+use crate::{http as reply, routes::Routes};
+
+const DOWNLOAD_LIMIT: u64 = 40 << 20;
+const EXTRACT_LIMIT: u64 = 96 << 20;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "PascalCase")]
+struct Settings {
+    listen: String,
+    #[serde(rename = "TLSListen")]
+    tls_listen: String,
+    certificate: String,
+    key: String,
+    secret: String,
+    #[serde(rename = "DashboardURL")]
+    dashboard_url: String,
+    dashboard_name: String,
+    home: PathBuf,
+    dashboard_root: PathBuf,
+    store_selected: bool,
+}
+
+pub struct OpenWrt {
+    config: Settings,
+    tls: Option<TlsAcceptor>,
+    selection: Mutex<BTreeMap<String, String>>,
+    update: Mutex<()>,
+}
+
+impl OpenWrt {
+    pub fn load(file: &Path) -> Result<Self, String> {
+        let data = std::fs::read(file).map_err(|err| err.to_string())?;
+        let mut config: Settings = serde_json::from_slice(&data).map_err(|err| err.to_string())?;
+        if !config.home.is_absolute()
+            || !config.dashboard_root.is_absolute()
+            || config.dashboard_name == "."
+            || config.dashboard_name == ".."
+            || config.dashboard_name.contains(['/', '\\', '?', '#', '%'])
+        {
+            return Err("invalid dashboard configuration".into());
+        }
+        for address in [&mut config.listen, &mut config.tls_listen] {
+            if address.is_empty() {
+                continue;
+            }
+            *address = crate::listen_address(address);
+            let authority: http::uri::Authority = address
+                .parse()
+                .map_err(|_| format!("invalid dashboard listen address {address:?}"))?;
+            let port = authority
+                .port_u16()
+                .filter(|port| *port != 0)
+                .ok_or_else(|| format!("invalid dashboard listen address {address:?}"))?;
+            let host = authority.host().trim_matches(['[', ']']);
+            if host.eq_ignore_ascii_case("localhost") {
+                *address = format!("127.0.0.1:{port}");
+            } else if config.secret.is_empty()
+                && !host.parse::<IpAddr>().is_ok_and(|ip| ip.is_loopback())
+            {
+                return Err("a dashboard on a non-loopback address requires an API secret".into());
+            }
+        }
+        if !config.listen.is_empty() && config.listen == config.tls_listen {
+            return Err("HTTP and HTTPS dashboard addresses overlap".into());
+        }
+        let tls = if config.tls_listen.is_empty() {
+            None
+        } else {
+            let cert = pem(&config.home, &config.certificate)?;
+            let key = pem(&config.home, &config.key)?;
+            let cert = CertificateDer::pem_slice_iter(&cert)
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|err| format!("dashboard certificate: {err}"))?;
+            let key = PrivateKeyDer::from_pem_slice(&key)
+                .map_err(|err| format!("dashboard key: {err}"))?;
+            let mut tls = rustls::ServerConfig::builder_with_provider(Arc::new(
+                rustls::crypto::aws_lc_rs::default_provider(),
+            ))
+            .with_safe_default_protocol_versions()
+            .map_err(|err| err.to_string())?
+            .with_no_client_auth()
+            .with_single_cert(cert, key)
+            .map_err(|err| err.to_string())?;
+            tls.alpn_protocols = vec![b"h2".to_vec(), b"http/1.1".to_vec()];
+            Some(TlsAcceptor::from(Arc::new(tls)))
+        };
+        let mut selection = BTreeMap::new();
+        if config.store_selected {
+            match std::fs::read(config.home.join("selections.json")) {
+                Ok(data) => match serde_json::from_slice(&data) {
+                    Ok(saved) => selection = saved,
+                    Err(err) => tracing::warn!("ignoring invalid saved policy selections: {err}"),
+                },
+                Err(err) if err.kind() == io::ErrorKind::NotFound => {}
+                Err(err) => return Err(format!("saved policy selections: {err}")),
+            }
+        }
+        Ok(Self {
+            config,
+            tls,
+            selection: Mutex::new(selection),
+            update: Mutex::new(()),
+        })
+    }
+
+    pub fn spawn(
+        self,
+        control: Arc<Control>,
+        status_socket: Option<PathBuf>,
+        stop: CancellationToken,
+    ) -> tokio::task::JoinHandle<()> {
+        let cors = control.external_controller().borrow().cors.clone();
+        let state = Arc::new(self);
+        tokio::spawn(async move {
+            let tracker = TaskTracker::new();
+            let ended = stop.child_token();
+            let _guard = ended.clone().drop_guard();
+            let sessions = Tasks::current(tracker.clone(), ended.clone());
+            let routes = Arc::new(Routes { control, sessions });
+            let restore = routes.sessions.spawn(state.clone().restore(routes.clone()));
+            tokio::select! {
+                _ = async {
+                    let _ = tokio::join!(
+                        state
+                            .clone()
+                            .serve(&state.config.listen, None, routes.clone(), cors.clone()),
+                        state.clone().serve(
+                            &state.config.tls_listen,
+                            state.tls.clone(),
+                            routes.clone(),
+                            cors
+                        ),
+                        serve_status(status_socket, routes.clone()),
+                    );
+                } => {},
+                () = stop.cancelled() => {},
+            }
+            ended.cancel();
+            restore.abort();
+            tracker.close();
+            tracker.wait().await;
+        })
+    }
+
+    async fn serve(
+        self: Arc<Self>,
+        address: &str,
+        tls: Option<TlsAcceptor>,
+        routes: Arc<Routes>,
+        cors: ControllerCors,
+    ) {
+        if address.is_empty() {
+            return;
+        }
+        let mut reported = false;
+        let listener = loop {
+            match TcpListener::bind(address).await {
+                Ok(listener) => break listener,
+                Err(err) if !reported => {
+                    tracing::warn!("dashboard cannot listen on {address}: {err}; retrying");
+                    reported = true;
+                }
+                Err(_) => {}
+            }
+            time::sleep(time::Duration::from_secs(1)).await;
+        };
+        let cors = Arc::new(cors);
+        loop {
+            let socket = match listener.accept().await {
+                Ok((socket, _)) => socket,
+                Err(err) => {
+                    tracing::warn!("dashboard accept: {err}");
+                    time::sleep(time::Duration::from_millis(100)).await;
+                    continue;
+                }
+            };
+            let (state, conn_routes, tls, cors) =
+                (self.clone(), routes.clone(), tls.clone(), cors.clone());
+            routes.sessions.spawn(async move {
+                if let Some(tls) = tls {
+                    if let Ok(Ok(stream)) =
+                        time::timeout(time::Duration::from_secs(5), tls.accept(socket)).await
+                    {
+                        state.connection(stream, conn_routes, cors).await;
+                    }
+                } else {
+                    state.connection(socket, conn_routes, cors).await;
+                }
+            });
+        }
+    }
+
+    async fn connection<T>(
+        self: Arc<Self>,
+        stream: T,
+        routes: Arc<Routes>,
+        cors: Arc<ControllerCors>,
+    ) where
+        T: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin + Send + 'static,
+    {
+        use hyper_util::rt::{TokioExecutor, TokioIo, TokioTimer};
+        let service = hyper::service::service_fn(move |request| {
+            let (state, routes, cors) = (self.clone(), routes.clone(), cors.clone());
+            async move {
+                let mut response = state.answer(&routes, &cors, request).await;
+                response.headers_mut().insert(
+                    header::REFERRER_POLICY,
+                    header::HeaderValue::from_static("no-referrer"),
+                );
+                Ok::<_, std::convert::Infallible>(response)
+            }
+        });
+        let mut server = hyper_util::server::conn::auto::Builder::new(TokioExecutor::new());
+        server
+            .http1()
+            .timer(TokioTimer::new())
+            .header_read_timeout(time::Duration::from_secs(5));
+        let _ = server
+            .serve_connection_with_upgrades(TokioIo::new(stream), service)
+            .await;
+    }
+
+    async fn answer(
+        &self,
+        routes: &Routes,
+        cors: &ControllerCors,
+        mut request: Request<Incoming>,
+    ) -> Response<reply::Body> {
+        match request.uri().path() {
+            path if path == "/ui" || path.starts_with("/ui/") => {
+                return self.dashboard(request).await;
+            }
+            "/upgrade/ui" => {
+                if request.method() != Method::POST {
+                    return reply::empty(StatusCode::METHOD_NOT_ALLOWED);
+                }
+                if !reply::authorized(&self.config.secret, request.headers(), request.uri()) {
+                    return reply::unauthorized();
+                }
+                if request.headers().contains_key(header::ORIGIN) {
+                    return reply::error(StatusCode::FORBIDDEN, "use the LuCI update button");
+                }
+                let _guard = self.update.lock().await;
+                return match self.update_dashboard().await {
+                    Ok(()) => reply::json(&serde_json::json!({ "status": "success" })),
+                    Err(err) => {
+                        tracing::warn!("dashboard update: {err}");
+                        reply::error(StatusCode::BAD_GATEWAY, "dashboard update failed")
+                    }
+                };
+            }
+            "/upgrade/geo" if request.method() == Method::POST => {
+                *request.uri_mut() = http::Uri::from_static("/configs/geo");
+            }
+            _ => {}
+        }
+        if self.config.store_selected && matches!(*request.method(), Method::PUT | Method::DELETE) {
+            let path = reply::segments(request.uri().path());
+            if let [kind, group] = path.as_slice()
+                && kind == "proxies"
+            {
+                let group = group.clone();
+                let remove = request.method() == Method::DELETE;
+                let mut saved = self.selection.lock().await;
+                let response = crate::answer(routes, &self.config.secret, cors, request).await;
+                if response.status().is_success() {
+                    let mut next = saved.clone();
+                    if remove {
+                        next.remove(&group);
+                    } else if let Some(name) = routes.control.selections().remove(&group) {
+                        next.insert(group, name);
+                    }
+                    if *saved != next {
+                        if let Err(err) = save(&self.config.home, &next) {
+                            tracing::warn!("saving policy selections: {err}");
+                            return reply::error(
+                                StatusCode::INTERNAL_SERVER_ERROR,
+                                "could not save policy selection",
+                            );
+                        }
+                        *saved = next;
+                    }
+                }
+                return response;
+            }
+        }
+        crate::answer(routes, &self.config.secret, cors, request).await
+    }
+
+    async fn restore(self: Arc<Self>, routes: Arc<Routes>) {
+        let mut pending = self.selection.lock().await.clone();
+        let restore = async {
+            while !pending.is_empty() {
+                for (group, name) in pending.clone() {
+                    let saved = self.selection.lock().await;
+                    if saved.get(&group) != Some(&name)
+                        || routes
+                            .control
+                            .proxy_select_as(
+                                Origin::Controller,
+                                ProxySelectParams {
+                                    group: group.clone(),
+                                    proxy: name,
+                                },
+                            )
+                            .await
+                            .is_ok()
+                    {
+                        pending.remove(&group);
+                    }
+                }
+                if !pending.is_empty() {
+                    time::sleep(time::Duration::from_millis(500)).await;
+                }
+            }
+        };
+        if time::timeout(time::Duration::from_secs(30), restore)
+            .await
+            .is_err()
+        {
+            tracing::warn!("could not restore all saved policy selections");
+        }
+    }
+
+    async fn dashboard(&self, request: Request<Incoming>) -> Response<reply::Body> {
+        if !matches!(*request.method(), Method::GET | Method::HEAD) {
+            return reply::empty(StatusCode::METHOD_NOT_ALLOWED);
+        }
+        let name = &self.config.dashboard_name;
+        let prefix = if name.is_empty() {
+            "/ui/".to_string()
+        } else {
+            format!("/ui/{name}/")
+        };
+        let path = request.uri().path();
+        if path == "/ui"
+            || path == prefix.trim_end_matches('/')
+            || (path == "/ui/" && !name.is_empty())
+        {
+            let location = request
+                .uri()
+                .query()
+                .map_or(prefix.clone(), |query| format!("{prefix}?{query}"));
+            let mut response = reply::empty(StatusCode::TEMPORARY_REDIRECT);
+            if let Ok(value) = header::HeaderValue::from_str(&location) {
+                response.headers_mut().insert(header::LOCATION, value);
+            }
+            return response;
+        }
+        let Some(path) = path.strip_prefix(&prefix) else {
+            return reply::not_found();
+        };
+        let path = percent_encoding::percent_decode_str(path).decode_utf8_lossy();
+        let path = if path.is_empty() {
+            Path::new("index.html")
+        } else {
+            Path::new(path.as_ref())
+        };
+        if !path
+            .components()
+            .all(|part| matches!(part, Component::Normal(_)))
+        {
+            return reply::not_found();
+        }
+        let current = self.config.home.join("dashboard/current");
+        let root = if tokio::fs::metadata(current.join("index.html"))
+            .await
+            .is_ok()
+        {
+            &current
+        } else {
+            &self.config.dashboard_root
+        };
+        let Ok(root) = tokio::fs::canonicalize(root).await else {
+            return reply::not_found();
+        };
+        let Ok(file) = tokio::fs::canonicalize(root.join(path)).await else {
+            return reply::not_found();
+        };
+        if !file.starts_with(&root) {
+            return reply::not_found();
+        }
+        let Ok(metadata) = tokio::fs::metadata(&file).await else {
+            return reply::not_found();
+        };
+        if !metadata.is_file() {
+            return reply::not_found();
+        }
+        let body = if request.method() == Method::HEAD {
+            reply::full(bytes::Bytes::new())
+        } else {
+            let Ok(file) = tokio::fs::File::open(&file).await else {
+                return reply::not_found();
+            };
+            let frames = ReaderStream::new(file)
+                .filter_map(|chunk| async { chunk.ok().map(|bytes| Ok(Frame::data(bytes))) });
+            BodyExt::boxed_unsync(StreamBody::new(frames))
+        };
+        let mime = mime_guess::from_path(path).first_or_octet_stream();
+        Response::builder()
+            .header(header::CONTENT_TYPE, mime.as_ref())
+            .header(header::CONTENT_LENGTH, metadata.len())
+            .body(body)
+            .unwrap_or_else(|_| reply::not_found())
+    }
+
+    async fn update_dashboard(&self) -> Result<(), String> {
+        let source = url::Url::parse(&self.config.dashboard_url).map_err(|err| err.to_string())?;
+        if source.scheme() != "https"
+            || source.host().is_none()
+            || !source.username().is_empty()
+            || source.password().is_some()
+        {
+            return Err("dashboard source must be an HTTPS URL without credentials".into());
+        }
+        let root = self.config.home.join("dashboard");
+        std::fs::create_dir_all(&root).map_err(|err| err.to_string())?;
+        let archive = tempfile::NamedTempFile::new_in(&root).map_err(|err| err.to_string())?;
+        let result = tokio::process::Command::new("curl")
+            .kill_on_drop(true)
+            .args([
+                "--disable",
+                "--noproxy",
+                "*",
+                "--silent",
+                "--fail",
+                "--location",
+                "--proto",
+                "=https",
+                "--proto-redir",
+                "=https",
+                "--disallow-username-in-url",
+                "--max-redirs",
+                "9",
+                "--max-time",
+                "35",
+                "--max-filesize",
+                &DOWNLOAD_LIMIT.to_string(),
+                "--write-out",
+                "%{http_code}",
+                "--output",
+            ])
+            .arg(archive.path())
+            .arg(source.as_str())
+            .output()
+            .await
+            .map_err(|err| err.to_string())?;
+        if !result.status.success() || result.stdout != b"200" {
+            return Err("dashboard download failed".into());
+        }
+        tokio::task::spawn_blocking(move || install(archive, &root))
+            .await
+            .map_err(|err| err.to_string())?
+            .map_err(|err| err.to_string())
+    }
+}
+
+struct StatusSocket {
+    path: PathBuf,
+    inode: u64,
+}
+
+impl Drop for StatusSocket {
+    fn drop(&mut self) {
+        if std::fs::symlink_metadata(&self.path)
+            .is_ok_and(|meta| meta.file_type().is_socket() && meta.ino() == self.inode)
+        {
+            let _ = std::fs::remove_file(&self.path);
+        }
+    }
+}
+
+async fn bind_status(path: &Path) -> io::Result<(UnixListener, StatusSocket)> {
+    match std::fs::symlink_metadata(path) {
+        Ok(meta) if meta.file_type().is_socket() => match UnixStream::connect(path).await {
+            Err(err) if err.kind() == io::ErrorKind::ConnectionRefused => {
+                std::fs::remove_file(path)?
+            }
+            Ok(_) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::AddrInUse,
+                    "status socket already in use",
+                ));
+            }
+            Err(err) => return Err(err),
+        },
+        Ok(_) => {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "status socket path is occupied",
+            ));
+        }
+        Err(err) if err.kind() == io::ErrorKind::NotFound => {}
+        Err(err) => return Err(err),
+    }
+    let listener = UnixListener::bind(path)?;
+    let guard = StatusSocket {
+        path: path.to_owned(),
+        inode: std::fs::symlink_metadata(path)?.ino(),
+    };
+    std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))?;
+    Ok((listener, guard))
+}
+
+async fn serve_status(path: Option<PathBuf>, routes: Arc<Routes>) {
+    use hyper_util::rt::{TokioIo, TokioTimer};
+    let Some(path) = path else { return };
+    let (listener, _socket) = match bind_status(&path).await {
+        Ok(bound) => bound,
+        Err(err) => {
+            tracing::warn!("could not start local rule status socket: {err}");
+            return;
+        }
+    };
+    loop {
+        let socket = match listener.accept().await {
+            Ok((socket, _)) => socket,
+            Err(err) => {
+                tracing::warn!("local rule status accept: {err}");
+                time::sleep(time::Duration::from_millis(100)).await;
+                continue;
+            }
+        };
+        let conn_routes = routes.clone();
+        routes.sessions.spawn(async move {
+            let service = hyper::service::service_fn(move |request: Request<Incoming>| {
+                let routes = conn_routes.clone();
+                async move {
+                    let response = if request.method() == Method::GET
+                        && request.uri().path() == "/providers/rules"
+                    {
+                        routes.handle(request).await
+                    } else {
+                        reply::not_found()
+                    };
+                    Ok::<_, std::convert::Infallible>(response)
+                }
+            });
+            let mut server = hyper::server::conn::http1::Builder::new();
+            server
+                .timer(TokioTimer::new())
+                .header_read_timeout(time::Duration::from_secs(2))
+                .keep_alive(false);
+            let _ = time::timeout(
+                time::Duration::from_secs(2),
+                server.serve_connection(TokioIo::new(socket), service),
+            )
+            .await;
+        });
+    }
+}
+
+fn pem(home: &Path, value: &str) -> Result<Vec<u8>, String> {
+    if value.starts_with("-----BEGIN ") {
+        Ok(value.as_bytes().to_vec())
+    } else if value.is_empty() {
+        Err("dashboard TLS needs a certificate and private key".into())
+    } else {
+        std::fs::read(home.join(value)).map_err(|err| format!("dashboard TLS file: {err}"))
+    }
+}
+
+fn save(home: &Path, selection: &BTreeMap<String, String>) -> io::Result<()> {
+    let mut file = tempfile::NamedTempFile::new_in(home)?;
+    serde_json::to_writer(&mut file, selection)?;
+    file.flush()?;
+    file.persist(home.join("selections.json"))?;
+    Ok(())
+}
+
+fn install(archive: tempfile::NamedTempFile, root: &Path) -> io::Result<()> {
+    if archive.as_file().metadata()?.len() > DOWNLOAD_LIMIT {
+        return Err(io::Error::other("dashboard download too large"));
+    }
+    let mut zip = zip::ZipArchive::new(archive.reopen()?)?;
+    if zip.len() > 4096 {
+        return Err(io::Error::other("too many dashboard files"));
+    }
+    let release = tempfile::Builder::new()
+        .prefix("release-")
+        .tempdir_in(root)?;
+    let mut index = None::<PathBuf>;
+    let mut remaining = EXTRACT_LIMIT;
+    for id in 0..zip.len() {
+        let mut entry = zip.by_index(id)?;
+        let path = entry
+            .enclosed_name()
+            .filter(|path| {
+                !entry.name().contains('\\')
+                    && path
+                        .components()
+                        .all(|part| matches!(part, Component::Normal(_)))
+            })
+            .ok_or_else(|| io::Error::other("unsafe dashboard archive path"))?;
+        let target = release.path().join(&path);
+        if entry.is_dir() {
+            std::fs::create_dir_all(target)?;
+            continue;
+        }
+        let size = entry.size();
+        if !entry.is_file() || size > remaining {
+            return Err(io::Error::other("invalid dashboard archive entry"));
+        }
+        std::fs::create_dir_all(target.parent().expect("entry within release directory"))?;
+        let mut file = std::fs::File::create_new(target)?;
+        if io::copy(&mut entry.by_ref().take(size + 1), &mut file)? != size {
+            return Err(io::Error::other("dashboard file size mismatch"));
+        }
+        remaining -= size;
+        if path.file_name().is_some_and(|name| name == "index.html") {
+            let parent = path.parent().unwrap_or(Path::new(""));
+            if index
+                .as_ref()
+                .is_none_or(|old| parent.components().count() < old.components().count())
+            {
+                index = Some(parent.to_owned());
+            }
+        }
+    }
+    let index = index.ok_or_else(|| io::Error::other("dashboard archive has no index.html"))?;
+    let link = release.path().join(".current");
+    let target = Path::new(
+        release
+            .path()
+            .file_name()
+            .expect("release directory has a name"),
+    )
+    .join(index);
+    let current = root.join("current");
+    let previous = std::fs::read_link(&current).ok();
+    std::os::unix::fs::symlink(&target, &link)?;
+    std::fs::rename(link, current)?;
+    let _ = release.keep();
+    if let Some(Component::Normal(old)) = previous
+        .as_deref()
+        .and_then(|path| path.components().next())
+        && old.to_string_lossy().starts_with("release-")
+        && target.components().next() != Some(Component::Normal(old))
+    {
+        let _ = std::fs::remove_dir_all(root.join(old));
+    }
+    Ok(())
+}
