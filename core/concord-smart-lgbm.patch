+        return 6;
+    }
+    if is_game_port(port) {
+        return 1;
+    }
+    if is_comm_port(port) {
+        return 2;
+    }
+    if let Some(cat) = well_known_port_category(port) {
+        return cat;
+    }
+    if let Some(cat) = game_comm_range_category(port) {
+        return match cat {
+            1 => 3,
+            2 => 4,
+            _ => 5,
+        };
+    }
+    if port <= 1023 {
+        8
+    } else if port <= 49151 {
+        9
+    } else {
+        10
+    }
+}
