+pub fn prepare_features(input: &ModelInput) -> Vec<f64> {
+    prepare_features_at(input, now_unix_secs())
+}
+
+pub fn prepare_features_at(input: &ModelInput, now_unix: i64) -> Vec<f64> {
+    let mut features = Vec::with_capacity(MAX_FEATURE_SIZE);
+
+    let upload_mb = input.upload_mb.max(0.0);
+    let download_mb = input.download_mb.max(0.0);
+    let max_upload_rate_kb = input.max_upload_rate_kb.max(0.0);
+    let max_download_rate_kb = input.max_download_rate_kb.max(0.0);
+    let duration_minutes = input.duration_minutes.max(0.0);
+    let last_used_seconds = if input.last_used_unix > 0 {
+        (now_unix - input.last_used_unix).max(0) as f64
+    } else {
+        0.0
+    };
+
+    features.push(input.success as f64);
+    features.push(input.failure as f64);
+    features.push((input.connect_time_ms.max(0) as f64).ln_1p());
+    features.push((input.latency_ms.max(0) as f64).ln_1p());
+    features.push(upload_mb.ln_1p());
+    features.push(input.history_upload_mb.max(0.0).ln_1p());
+    features.push(max_upload_rate_kb.ln_1p());
+    features.push(input.history_max_upload_rate_kb.max(0.0).ln_1p());
+    features.push(download_mb.ln_1p());
+    features.push(input.history_download_mb.max(0.0).ln_1p());
+    features.push(max_download_rate_kb.ln_1p());
+    features.push(input.history_max_download_rate_kb.max(0.0).ln_1p());
+    features.push(duration_minutes.ln_1p());
+    features.push(input.history_duration_minutes.max(0.0).ln_1p());
+    features.push(last_used_seconds.ln_1p());
+
+    features.push(if input.is_udp { 1.0 } else { 0.0 });
+    features.push(if input.is_tcp { 1.0 } else { 0.0 });
+    features.push(input.loss_rate);
+    features.push(input.cumul_loss_rate);
+
+    features.push(f64::from(extract_asn_feature(&input.dest_ip_asn)));
+    features.push(f64::from(extract_geoip_feature(&input.dest_geoip)));
+
+    let address_feature = if !input.host.is_empty() {
+        extract_domain_type_feature(&input.host)
+    } else if !input.dest_ip.is_empty() {
+        extract_ip_feature(&input.dest_ip)
+    } else {
+        0
+    };
+    features.push(f64::from(address_feature));
+
+    let port_feature = extract_port_feature(input.dest_port);
+    features.push(f64::from(port_feature));
+
+    let traffic_ratio = if upload_mb > 0.0 && download_mb > 0.0 {
+        if upload_mb > download_mb {
+            download_mb / upload_mb
+        } else {
+            -upload_mb / download_mb
+        }
+    } else {
+        0.0
+    };
+    features.push(traffic_ratio);
+
+    let traffic_density = if duration_minutes > 0.0 {
+        ((upload_mb + download_mb) / duration_minutes).ln_1p()
+    } else {
+        0.0
+    };
+    features.push(traffic_density);
+
+    let conn_type = derive_connection_type(input.dest_port, address_feature, port_feature);
+    features.push(f64::from(conn_type));
+
+    features.push(hash_string_to_float(&input.dest_ip_asn, 500));
+    features.push(hash_string_to_float(&input.host, 1000));
+    features.push(hash_string_to_float(&input.dest_ip, 10000));
+    features.push(hash_string_to_float(&input.dest_geoip, 200));
+
+    features.push(f64::from(extract_exit_region_feature(&input.exit_region)));
+    features.push(hash_string_to_float(&input.exit_asn, 500));
+
+    debug_assert_eq!(features.len(), MAX_FEATURE_SIZE);
+    features
+}
