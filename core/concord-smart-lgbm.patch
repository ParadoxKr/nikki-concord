+fn identify_scene(
+    is_udp: bool,
+    latency: i64,
+    upload_mb: f64,
+    download_mb: f64,
+    max_upload_kb: f64,
+    max_download_kb: f64,
+    duration_min: f64,
+) -> Scene {
+    let total_rate = if duration_min > 0.0 {
+        (upload_mb + download_mb) / duration_min
+    } else {
+        0.0
+    };
+    if (is_udp
+        && latency < 150
+        && duration_min > 3.0
+        && upload_mb > 0.2
+        && download_mb > 0.2
+        && max_upload_kb > 200.0
+        && max_download_kb > 200.0
+        && total_rate > 0.1
+        && total_rate < 10.0)
+        || (!is_udp
+            && latency < 250
+            && duration_min > 3.0
+            && upload_mb > 0.1
+            && download_mb > 0.1
+            && upload_mb < 150.0
+            && download_mb < 150.0
+            && (upload_mb / download_mb) > 0.2
+            && (upload_mb / download_mb) < 5.0
+            && max_upload_kb > 150.0
+            && max_download_kb > 150.0
+            && total_rate > 0.05
+            && total_rate < 15.0)
+    {
+        return Scene::Interactive;
+    }
+    if (upload_mb > 100.0 || download_mb > 100.0 || max_upload_kb > 5000.0)
+        && duration_min > 0.5
+        && total_rate > 5.0
+    {
+        return Scene::Transfer;
+    }
+    if duration_min > 1.0 && upload_mb > 0.0 && max_upload_kb > 0.0 {
+        let dl_tp = download_mb / duration_min;
+        if (download_mb > 60.0
+            && download_mb / upload_mb > 3.0
+            && max_download_kb > 2000.0
+            && max_download_kb / max_upload_kb > 4.0
+            && dl_tp > 5.0)
+            || (download_mb > 15.0
+                && download_mb / upload_mb > 3.0
+                && max_download_kb > 1000.0
+                && max_download_kb / max_upload_kb > 3.0
+                && dl_tp > 2.0)
+        {
+            return Scene::Streaming;
+        }
+    }
+    Scene::Web
+}
+
+fn time_decay(last_used: i64, now: i64, min_decay: f64) -> f64 {
+    let fuzzy = (last_used / 3600) * 3600;
+    let hours = ((now - fuzzy).max(0) as f64) / 3600.0;
+    let decay = if hours <= 24.0 {
+        1.0
+    } else if hours <= 72.0 {
+        1.0 - (hours - 24.0) / 48.0 * 0.2
+    } else if hours <= 168.0 {
+        0.8 - (hours - 72.0) / 96.0 * 0.3
+    } else if hours <= 720.0 {
+        0.5 - (hours - 168.0) / 552.0 * 0.2
+    } else {
+        0.1
+    };
+    decay.max(min_decay)
+}
+
+fn traffic_factor(
+    traffic_mb: f64,
+    max_rate_kb: f64,
+    duration_min: f64,
+    hist_max_rate_kb: f64,
+    hist_total_mb: f64,
+    hist_duration_min: f64,
+    is_short: bool,
+) -> f64 {
+    if traffic_mb <= 0.0 || duration_min <= 0.0 {
+        return 0.0;
+    }
+    let base = if traffic_mb < 0.005 {
+        0.10 + 0.05 * (traffic_mb / 0.001).log10()
+    } else if traffic_mb < 0.01 {
+        0.18 + 0.08 * (traffic_mb / 0.005).log10()
+    } else if traffic_mb < 0.05 {
+        0.35 + 0.10 * (traffic_mb / 0.01).log10()
+    } else if traffic_mb < 0.1 {
+        0.53 + 0.15 * (traffic_mb / 0.05).log10()
+    } else if traffic_mb < 0.5 {
+        0.72 + 0.18 * (traffic_mb / 0.1).log10()
+    } else if traffic_mb < 1.0 {
+        0.98 + 0.15 * (traffic_mb / 0.5).log10()
+    } else if traffic_mb < 5.0 {
+        1.18 + 0.10 * traffic_mb.log10()
+    } else if traffic_mb < 20.0 {
+        1.32 + 0.08 * (traffic_mb / 5.0).log10()
+    } else if traffic_mb < 100.0 {
+        1.45 + 0.06 * (traffic_mb / 20.0).log10()
+    } else if traffic_mb < 500.0 {
+        1.56 + 0.05 * (traffic_mb / 100.0).log10()
+    } else if traffic_mb < 3000.0 {
+        1.66 + 0.04 * (traffic_mb / 500.0).log10()
+    } else {
+        1.74 + 0.02 * (traffic_mb / 3000.0).log10()
+    };
+
+    let rate_bonus = if max_rate_kb < 20.0 {
+        1.0 + 0.05 * (max_rate_kb / 20.0)
+    } else if max_rate_kb < 100.0 {
+        1.05 + 0.05 * ((max_rate_kb - 20.0) / 80.0)
+    } else if max_rate_kb < 500.0 {
+        1.10 + 0.05 * ((max_rate_kb - 100.0) / 400.0)
+    } else if max_rate_kb < 2000.0 {
+        1.15 + 0.05 * ((max_rate_kb - 500.0) / 1500.0)
+    } else if max_rate_kb < 5000.0 {
+        1.20 + 0.04 * ((max_rate_kb - 2000.0) / 3000.0)
+    } else if max_rate_kb < 20000.0 {
+        1.24 + 0.04 * ((max_rate_kb - 5000.0) / 15000.0)
+    } else if max_rate_kb < 100000.0 {
+        (1.28 + 0.03 * (max_rate_kb / 20000.0).log10()).min(1.32)
+    } else {
+        (1.32 + 0.02 * (max_rate_kb / 100000.0).log10()).min(1.36)
+    };
+
+    let throughput_kbs = (traffic_mb * 1024.0) / (duration_min * 60.0).max(1.0);
+    let accel_bonus = if throughput_kbs > 0.0 {
+        let ratio = max_rate_kb / throughput_kbs;
+        if ratio > 2.0 {
+            1.0 + (0.02 * (ratio - 2.0)).min(0.12)
+        } else {
+            1.0
+        }
+    } else {
+        1.0
+    };
+
+    let history_penalty = if hist_max_rate_kb > 0.0 {
+        let r = max_rate_kb / hist_max_rate_kb;
+        if r < 0.5 {
+            0.6 + 0.4 * r
+        } else if r < 0.9 {
+            0.85 + 0.15 * r
+        } else if r > 1.2 {
+            1.0 + (0.02 * (r - 1.2)).min(0.05)
+        } else {
+            1.0
+        }
+    } else {
+        1.0
+    };
+
+    let mut combined = rate_bonus * accel_bonus * history_penalty;
+    if hist_max_rate_kb > 0.0 {
+        let history_ratio = max_rate_kb / hist_max_rate_kb;
+        let history_avg_kbs = if hist_total_mb > 0.0 && hist_duration_min > 0.0 {
+            (hist_total_mb * 1024.0) / (hist_duration_min * 60.0).max(1.0)
+        } else {
+            0.0
+        };
+        let low_tp = if history_avg_kbs > 0.0 {
+            throughput_kbs < 0.3 * history_avg_kbs
+        } else {
+            throughput_kbs < 10.0
+        };
+        if history_ratio < 0.1 && low_tp {
+            let evidence = if hist_duration_min > 0.0 && duration_min > 0.0 {
+                ((hist_duration_min / duration_min - 1.0) / 4.0).clamp(0.0, 1.0)
+            } else {
+                0.0
+            };
+            combined *= 1.0 - 0.5 * evidence;
+        }
+    }
+    combined = combined.min(1.25);
+
+    let tp = traffic_mb / duration_min.max(1.0);
+    let conn_factor = if is_short {
+        1.0 + 0.06 * (tp / 25.0).min(1.0)
+    } else if tp > 5.0 {
+        1.0 + 0.05 * ((tp - 5.0) / 80.0).min(1.0)
+    } else {
+        1.0
+    };
+
+    (base * combined * conn_factor).min(1.25)
+}
