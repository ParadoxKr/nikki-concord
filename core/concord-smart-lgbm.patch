+fn load_transforms_tail(file: &mut File) -> io::Result<FeatureTransforms> {
+    let len = file.metadata()?.len();
+    let read_size = len.min(16384);
+    file.seek(SeekFrom::End(-(read_size as i64)))?;
+    let mut buf = vec![0u8; read_size as usize];
+    file.read_exact(&mut buf)?;
+    let tail = String::from_utf8_lossy(&buf);
+    parse_transforms_tail(&tail)
+}
+
+fn parse_transforms_tail(tail: &str) -> io::Result<FeatureTransforms> {
+    let Some(start) = tail.find("[transforms]") else {
+        return Ok(FeatureTransforms::disabled());
+    };
+    let Some(after) = tail.get(start + "[transforms]".len()..) else {
+        return Ok(FeatureTransforms::disabled());
+    };
+    let Some(end) = after.find("[/transforms]") else {
+        return Err(parse_err("missing [/transforms]"));
+    };
+    let Some(content) = after.get(..end) else {
+        return Err(parse_err("invalid [/transforms] span"));
+    };
+
+    let mut section = "";
+    let mut enabled = false;
+    let mut order: HashMap<usize, String> = HashMap::new();
+    let mut defs: HashMap<String, HashMap<String, String>> = HashMap::new();
+
+    for raw in content.lines() {
+        let line = raw.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        if let Some(name) = line.strip_prefix('[').and_then(|s| s.strip_suffix(']')) {
+            section = if name.starts_with('/') { "" } else { name };
+            continue;
+        }
+        let Some((key, val)) = line.split_once('=') else {
+            continue;
+        };
+        let key = key.trim();
+        let val = val.trim();
+        match section {
+            "order" => {
+                if let Ok(idx) = key.parse::<usize>()
+                    && idx < MAX_FEATURE_SIZE
+                {
+                    order.insert(idx, val.to_string());
+                }
+            }
+            "definitions" => {
+                if let Some((id, param)) = key.split_once('_') {
+                    defs.entry(id.to_string())
+                        .or_default()
+                        .insert(param.to_string(), val.to_string());
+                }
+            }
+            _ => {
+                if key == "transform" {
+                    enabled = val == "true";
+                }
+            }
+        }
+    }
+
+    if order.is_empty() {
+        for (i, name) in DEFAULT_FEATURE_ORDER.iter().enumerate() {
+            order.insert(i, (*name).to_string());
+        }
+    } else if order.len() != MAX_FEATURE_SIZE {
+        for (i, name) in DEFAULT_FEATURE_ORDER.iter().enumerate() {
+            order.entry(i).or_insert_with(|| (*name).to_string());
+        }
+    }
+
+    let compatible = !enabled
+        || (order.len() == MAX_FEATURE_SIZE
+            && DEFAULT_FEATURE_ORDER
+                .iter()
+                .enumerate()
+                .all(|(i, expected)| order.get(&i).is_some_and(|actual| actual == expected)));
+
+    let mut scalers = Vec::new();
+    for params in defs.values() {
+        let Some(kind) = params.get("type") else {
+            continue;
+        };
+        let Some(feat_str) = params.get("features") else {
+            continue;
+        };
+        let indices: Vec<usize> = feat_str
+            .split(',')
+            .filter_map(|s| s.trim().parse::<usize>().ok())
+            .collect();
+        if indices.is_empty() || indices.iter().any(|&i| i >= MAX_FEATURE_SIZE) {
+            continue;
+        }
+        match kind.as_str() {
+            "StandardScaler" => {
+                let Some(mean) = params.get("mean").and_then(|s| parse_csv_f64(s)) else {
+                    continue;
+                };
+                let Some(scale) = params.get("scale").and_then(|s| parse_csv_f64(s)) else {
+                    continue;
+                };
+                if mean.len() == indices.len()
+                    && scale.len() == indices.len()
+                    && scale.iter().all(|&s| s != 0.0)
+                {
+                    scalers.push(Scaler::Standard {
+                        indices: indices.into_boxed_slice(),
+                        mean: mean.into_boxed_slice(),
+                        scale: scale.into_boxed_slice(),
+                    });
+                }
+            }
+            "RobustScaler" => {
+                let Some(center) = params.get("center").and_then(|s| parse_csv_f64(s)) else {
+                    continue;
+                };
+                let Some(scale) = params.get("scale").and_then(|s| parse_csv_f64(s)) else {
+                    continue;
+                };
+                if center.len() == indices.len()
+                    && scale.len() == indices.len()
+                    && scale.iter().all(|&s| s != 0.0)
+                {
+                    scalers.push(Scaler::Robust {
+                        indices: indices.into_boxed_slice(),
+                        center: center.into_boxed_slice(),
+                        scale: scale.into_boxed_slice(),
+                    });
+                }
+            }
+            _ => {}
+        }
+    }
+
+    Ok(FeatureTransforms {
+        enabled,
+        compatible,
+        scalers: scalers.into_boxed_slice(),
+    })
+}
+
+fn parse_csv_f64(s: &str) -> Option<Vec<f64>> {
+    if s.is_empty() {
+        return Some(Vec::new());
+    }
+    s.split(',')
+        .map(|part| part.trim().parse::<f64>().ok())
+        .collect()
+}
+
+fn now_unix_secs() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs() as i64)
+}
+
+fn hash_string_to_float(s: &str, buckets: u32) -> f64 {
+    if s.is_empty() || buckets == 0 {
+        return 0.0;
+    }
+    let mut hash: u32 = 2166136261;
+    for &b in s.as_bytes() {
+        hash ^= u32::from(b);
+        hash = hash.wrapping_mul(16777619);
+    }
+    f64::from((hash % buckets) + 1)
+}
