+            dest_port: 443,
+            dest_geoip: "US".into(),
+            dest_ip_asn: "AS15169 Google LLC".into(),
+            ..ModelInput::default()
+        };
+        let (w_fast, used_fast) = model.predict_weight(&fast_node, 1.0);
+        let (w_slow, used_slow) = model.predict_weight(&slow_node, 1.0);
