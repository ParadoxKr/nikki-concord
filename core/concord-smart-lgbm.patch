+    #[test]
+    fn smart_state_with_lightgbm_scores_and_flushes_weights() {
+        use std::sync::Arc;
+        use std::time::Duration;
+        use arc_swap::ArcSwapOption;
+        use super::super::{FlowEnd, Settings, SmartState, Stamp};
+
+        let model = Arc::new(WeightModel::load_from_bytes(TINY_MODEL.as_bytes()).unwrap());
+        let slot = Arc::new(ArcSwapOption::from(Some(model)));
+        let settings = Settings {
+            tolerance_ms: 0,
+            max_failed: 5,
+            half_life: Duration::from_secs(300),
+            probe_timeout: Duration::from_secs(5),
+        };
+        let state = SmartState::new_with_lgbm(settings, true, slot);
+        let now = Stamp::now();
+        let names: Vec<Arc<str>> = vec![Arc::from("a"), Arc::from("b")];
+        let cands = crate::smart::tests::cands(&names, &[100, 120]);
+        let view = cands.view();
+        // Initially 'a' wins (100ms < 120ms).
+        let (idx, _) = state.pick(now, None, &view, None, true);
+        assert_eq!(idx, 0);
+
+        // Give 'a' 3 successes (TINY_MODEL returns 0.4) and 'b' 10 successes (TINY_MODEL returns 0.8).
+        for _ in 0..3 {
+            let tap = state.flow_with_meta(names[0].clone(), Arc::from("example.com"), false, 443, None);
+            tap.on_upload_bytes(1024);
+            tap.on_download_bytes(4096);
+            let _ = tap.finish(FlowEnd { download: 4096, remote_first: Some(true), cancelled: false });
+        }
+        for _ in 0..10 {
+            let tap = state.flow_with_meta(names[1].clone(), Arc::from("example.com"), false, 443, None);
+            tap.on_upload_bytes(1024);
+            tap.on_download_bytes(4096);
+            let _ = tap.finish(FlowEnd { download: 4096, remote_first: Some(true), cancelled: false });
+        }
+
+        let weights = state.smart_weights(&view);
+        assert!(weights.get("b").copied().unwrap_or(0.0) > weights.get("a").copied().unwrap_or(0.0));
+
+        // Now 'b' effective score (120 / 0.8 = 150) beats 'a' (100 / 0.4 = 250)!
+        let (idx_after, _) = state.pick(now, None, &view, None, true);
+        assert_eq!(idx_after, 1);
+
+        // Flushing resets learned weights and restores raw delay preference ('a').
+        state.flush_smart_weights();
+        assert!(state.smart_weights(&view).is_empty());
+        let (idx_reset, _) = state.pick(now, None, &view, None, true);
+        assert_eq!(idx_reset, 0);
+    }
+}
