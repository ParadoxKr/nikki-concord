+fn looks_like_domain(host: &str) -> bool {
+    let mut parts = host.split('.');
+    let mut count = 0usize;
+    for part in &mut parts {
+        if part.is_empty()
+            || !part
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'-')
+        {
+            return false;
+        }
+        count += 1;
+    }
+    count >= 2
+}
+
+fn extract_domain_type_feature(host: &str) -> i32 {
+    if host.is_empty() {
+        return 0;
+    }
+    let lower = host.to_ascii_lowercase();
+    if lower.contains('[') || lower.parse::<IpAddr>().is_ok() {
+        return 1;
+    }
+    for (list, cat) in [
+        (DNS_KEYWORDS, 104),
+        (API_KEYWORDS, 103),
+        (GAME_KEYWORDS, 101),
+        (COMM_KEYWORDS, 102),
+        (STREAMING_KEYWORDS, 100),
+    ] {
+        for &kw in list {
+            if lower.contains(kw) {
+                return cat;
+            }
+        }
+    }
+    if lower.ends_with(".gov") {
+        return 114;
+    }
+    if lower.ends_with(".edu") {
+        return 115;
+    }
+    if lower.ends_with(".cn") {
+        return 110;
+    }
+    if lower.ends_with(".com") {
+        return 111;
+    }
+    if lower.ends_with(".net") {
+        return 112;
+    }
+    if lower.ends_with(".org") {
+        return 113;
+    }
+    if looks_like_domain(&lower) {
+        if lower.bytes().filter(|&b| b == b'.').count() >= 2 {
+            return 2;
+        }
+        return 3;
+    }
+    0
+}
