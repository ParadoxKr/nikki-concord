+fn derive_connection_type(port: u16, address_feature: i32, port_feature: i32) -> i32 {
+    if address_feature == 104 || port_feature == 7 || is_dns_port(port) {
+        return 7;
+    }
+    if address_feature == 103 || port_feature == 6 || is_api_port(port) {
+        return 6;
+    }
+    if address_feature == 101 || address_feature == 102 || is_game_port(port) || is_comm_port(port) {
+        return 3;
+    }
+    if address_feature == 100 {
+        return 2;
+    }
+    if matches!(port, 80 | 443) || matches!(port_feature, 103 | 106) {
+        return 1;
+    }
+    if matches!(port_feature, 112..=115) {
+        return 4;
+    }
+    if matches!(port, 20 | 21 | 22 | 989 | 990) {
+        return 5;
+    }
+    if game_comm_range_category(port).is_some() || (port > 10000 && port < 65000) {
+        return 3;
+    }
+    0
+}
