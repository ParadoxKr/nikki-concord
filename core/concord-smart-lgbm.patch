+
+    #[test]
+    fn parses_numerical_categorical_and_transforms() {
+        let model = WeightModel::load_from_bytes(TINY_MODEL.as_bytes()).unwrap();
+        assert_eq!(model.n_trees(), 1);
+        assert_eq!(model.n_features(), 30);
+
+        // success=4 -> scaled=(4-2)/1 = 2 <= 5.0 -> left leaf 0 => 0.4
+        let mut low = ModelInput {
+            success: 4,
+            failure: 0,
+            is_tcp: true,
+            ..ModelInput::default()
+        };
+        let (w_low, used) = model.predict_weight(&low, 1.0);
+        assert!(used);
+        assert!((w_low - 0.4).abs() < 1e-9, "got {w_low}");
+
+        // success=10 -> scaled=8 > 5.0 -> node 1 checks feature 19 (asn_feature)
+        // bit 100 = 3*32 + 4 -> word 3 has bit 4 (16) -> "google" maps to 100 -> left leaf 1 => 1.2
+        low.success = 10;
+        low.dest_ip_asn = "AS15169 Google LLC".into();
+        let (w_google, used) = model.predict_weight(&low, 1.5);
+        assert!(used);
+        assert!((w_google - 1.8).abs() < 1e-9, "got {w_google}");
+
+        // non-matching ASN goes to right leaf 2 => 0.8
+        low.dest_ip_asn = "AS13335 Cloudflare".into();
+        let (w_cf, used) = model.predict_weight(&low, 1.0);
+        assert!(used);
+        assert!((w_cf - 0.8).abs() < 1e-9, "got {w_cf}");
+    }
