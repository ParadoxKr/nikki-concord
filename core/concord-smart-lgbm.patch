@@ -0,0 +1,2189 @@
+//! Pure-Rust LightGBM v4 inference engine and feature pipeline compatible with
+//! vernesong/mihomo's `Model.bin` (including embedded `[transforms]` scalers) and
+//! heuristic fallback weight calculation.
+
+use std::collections::HashMap;
+use std::fs::File;
+use std::io::{self, BufRead, BufReader, Read, Seek, SeekFrom};
+use std::net::{IpAddr, Ipv4Addr, Ipv6Addr};
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+pub const DEFAULT_LGBM_URL: &str =
+    "https://github.com/vernesong/mihomo/releases/download/LightGBM-Model/Model.bin";
+pub const DEFAULT_MIN_SAMPLE_COUNT: i64 = 2;
+pub const MAX_FEATURE_SIZE: usize = 32;
+const MAX_MODEL_FEATURE_SLOTS: usize = 4096;
+const ZERO_THRESHOLD: f64 = 1e-35;
+
+const FLAG_CATEGORICAL: u8 = 1 << 0;
+const FLAG_DEFAULT_LEFT: u8 = 1 << 1;
+const FLAG_LEFT_LEAF: u8 = 1 << 2;
+const FLAG_RIGHT_LEAF: u8 = 1 << 3;
+const FLAG_MISSING_ZERO: u8 = 1 << 4;
+const FLAG_MISSING_NAN: u8 = 1 << 5;
+const FLAG_CAT_ONE_HOT: u8 = 1 << 6;
+const FLAG_CAT_SMALL: u8 = 1 << 7;
+
+const DEFAULT_FEATURE_ORDER: [&str; MAX_FEATURE_SIZE] = [
+    "success",
+    "failure",
+    "connect_time",
+    "latency",
+    "upload_mb",
+    "history_upload_mb",
+    "maxuploadrate_kb",
+    "history_maxuploadrate_kb",
+    "download_mb",
+    "history_download_mb",
+    "maxdownloadrate_kb",
+    "history_maxdownloadrate_kb",
+    "duration_minutes",
+    "history_duration_minutes",
+    "last_used_seconds",
+    "is_udp",
+    "is_tcp",
+    "loss_rate",
+    "cumul_loss_rate",
+    "asn_feature",
+    "country_feature",
+    "address_feature",
+    "port_feature",
+    "traffic_ratio",
+    "traffic_density",
+    "connection_type_feature",
+    "asn_hash",
+    "host_hash",
+    "ip_hash",
+    "geoip_hash",
+    "exit_region",
+    "exit_asn_hash",
+];
+
+#[derive(Clone, Debug, Default)]
+pub struct ModelInput {
+    pub success: i64,
+    pub failure: i64,
+    pub connect_time_ms: i64,
+    pub latency_ms: i64,
+
+    pub upload_mb: f64,
+    pub history_upload_mb: f64,
+    pub max_upload_rate_kb: f64,
+    pub history_max_upload_rate_kb: f64,
+
+    pub download_mb: f64,
+    pub history_download_mb: f64,
+    pub max_download_rate_kb: f64,
+    pub history_max_download_rate_kb: f64,
+
+    pub duration_minutes: f64,
+    pub history_duration_minutes: f64,
+    pub last_used_unix: i64,
+
+    pub is_udp: bool,
+    pub is_tcp: bool,
+    pub connection_failed: bool,
+    pub loss_rate: f64,
+    pub cumul_loss_rate: f64,
+    pub ema_loss_rate: f64,
+
+    pub dest_ip_asn: String,
+    pub host: String,
+    pub dest_ip: String,
+    pub dest_port: u16,
+    pub dest_geoip: String,
+
+    pub exit_region: String,
+    pub exit_asn: String,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct LgbmNode {
+    threshold: f64,
+    left: u32,
+    right: u32,
+    feature: u16,
+    flags: u8,
+}
+
+#[derive(Debug)]
+struct LinearLeaf {
+    constant: f64,
+    features: Box<[u16]>,
+    coeffs: Box<[f64]>,
+}
+
+#[derive(Debug)]
+struct LgbmTree {
+    nodes: Box<[LgbmNode]>,
+    leaf_values: Box<[f64]>,
+    cat_boundaries: Box<[u32]>,
+    cat_thresholds: Box<[u32]>,
+    linear_leaves: Option<Box<[LinearLeaf]>>,
+}
+
+impl LgbmTree {
+    #[inline]
+    fn numerical_decision(node: &LgbmNode, mut fval: f64) -> bool {
+        if fval.is_nan() && (node.flags & FLAG_MISSING_NAN == 0) {
+            fval = 0.0;
+        }
+        let is_missing_zero = (node.flags & FLAG_MISSING_ZERO != 0)
+            && (fval > -ZERO_THRESHOLD && fval <= ZERO_THRESHOLD);
+        let is_missing_nan = (node.flags & FLAG_MISSING_NAN != 0) && fval.is_nan();
+        if is_missing_zero || is_missing_nan {
+            return node.flags & FLAG_DEFAULT_LEFT != 0;
+        }
+        fval <= node.threshold
+    }
+
+    #[inline]
+    fn categorical_decision(&self, node: &LgbmNode, fval: f64) -> bool {
+        let ifval = if fval.is_nan() {
+            if node.flags & FLAG_MISSING_NAN != 0 {
+                return false;
+            }
+            0i32
+        } else {
+            fval as i32
+        };
+        if ifval < 0 {
+            return false;
+        }
+        let pos = ifval as u32;
+        if node.flags & FLAG_CAT_ONE_HOT != 0 {
+            return (node.threshold as u32) == pos;
+        }
+        if node.flags & FLAG_CAT_SMALL != 0 {
+            let mask = node.threshold as u32;
+            return pos < 32 && ((mask >> pos) & 1) != 0;
+        }
+        let cat_idx = node.threshold as usize;
+        let Some(&start) = self.cat_boundaries.get(cat_idx) else {
+            return false;
+        };
+        let Some(&end) = self.cat_boundaries.get(cat_idx + 1) else {
+            return false;
+        };
+        let word = (pos / 32) as usize;
+        let start = start as usize;
+        let end = end as usize;
+        if start + word >= end {
+            return false;
+        }
+        let bit = pos % 32;
+        self.cat_thresholds
+            .get(start + word)
+            .is_some_and(|w| ((w >> bit) & 1) != 0)
+    }
+
+    #[inline]
+    fn leaf_output(&self, leaf: usize, fvals: &[f64]) -> f64 {
+        if let Some(linear) = self.linear_leaves.as_ref()
+            && let Some(model) = linear.get(leaf)
+        {
+            let mut sum = model.constant;
+            for (&feat, &coeff) in model.features.iter().zip(model.coeffs.iter()) {
+                let v = fvals.get(feat as usize).copied().unwrap_or(0.0);
+                if v.is_nan() {
+                    return self.leaf_values.get(leaf).copied().unwrap_or(0.0);
+                }
+                sum += coeff * v;
+            }
+            return sum;
+        }
+        self.leaf_values.get(leaf).copied().unwrap_or(0.0)
+    }
+
+    #[inline]
+    fn predict(&self, fvals: &[f64]) -> f64 {
+        if self.nodes.is_empty() {
+            return self.leaf_output(0, fvals);
+        }
+        let mut idx = 0usize;
+        loop {
+            let Some(node) = self.nodes.get(idx) else {
+                return 0.0;
+            };
+            let fval = fvals.get(node.feature as usize).copied().unwrap_or(0.0);
+            let go_left = if node.flags & FLAG_CATEGORICAL != 0 {
+                self.categorical_decision(node, fval)
+            } else {
+                Self::numerical_decision(node, fval)
+            };
+            if go_left {
+                if node.flags & FLAG_LEFT_LEAF != 0 {
+                    return self.leaf_output(node.left as usize, fvals);
+                }
+                idx = node.left as usize;
+            } else {
+                if node.flags & FLAG_RIGHT_LEAF != 0 {
+                    return self.leaf_output(node.right as usize, fvals);
+                }
+                idx = node.right as usize;
+            }
+        }
+    }
+}
+
+#[derive(Debug)]
+pub struct LgbmEnsemble {
+    trees: Box<[LgbmTree]>,
+    max_feature_idx: usize,
+    average_output: bool,
+}
+
+impl LgbmEnsemble {
+    pub fn n_features(&self) -> usize {
+        if self.max_feature_idx > 0 {
+            self.max_feature_idx + 1
+        } else {
+            0
+        }
+    }
+
+    pub fn n_trees(&self) -> usize {
+        self.trees.len()
+    }
+
+    pub fn predict_single(&self, features: &[f64]) -> f64 {
+        if self.trees.is_empty() {
+            return 0.0;
+        }
+        let coef = if self.average_output {
+            1.0 / (self.trees.len() as f64)
+        } else {
+            1.0
+        };
+        let mut sum = 0.0f64;
+        for tree in &self.trees {
+            sum += tree.predict(features) * coef;
+        }
+        sum
+    }
+}
+
+#[derive(Clone, Debug)]
+enum Scaler {
+    Standard {
+        indices: Box<[usize]>,
+        mean: Box<[f64]>,
+        scale: Box<[f64]>,
+    },
+    Robust {
+        indices: Box<[usize]>,
+        center: Box<[f64]>,
+        scale: Box<[f64]>,
+    },
+}
+
+#[derive(Clone, Debug)]
+struct FeatureTransforms {
+    enabled: bool,
+    compatible: bool,
+    scalers: Box<[Scaler]>,
+}
+
+impl FeatureTransforms {
+    fn disabled() -> Self {
+        FeatureTransforms {
+            enabled: false,
+            compatible: true,
+            scalers: Box::new([]),
+        }
+    }
+
+    fn apply(&self, features: &mut [f64]) {
+        if !self.enabled {
+            return;
+        }
+        for scaler in &self.scalers {
+            match scaler {
+                Scaler::Standard {
+                    indices,
+                    mean,
+                    scale,
+                } => {
+                    for ((&idx, &m), &s) in indices.iter().zip(mean.iter()).zip(scale.iter()) {
+                        if let Some(slot) = features.get_mut(idx)
+                            && s != 0.0
+                        {
+                            *slot = (*slot - m) / s;
+                        }
+                    }
+                }
+                Scaler::Robust {
+                    indices,
+                    center,
+                    scale,
+                } => {
+                    for ((&idx, &c), &s) in indices.iter().zip(center.iter()).zip(scale.iter()) {
+                        if let Some(slot) = features.get_mut(idx)
+                            && s != 0.0
+                        {
+                            *slot = (*slot - c) / s;
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[derive(Debug)]
+pub struct WeightModel {
+    ensemble: LgbmEnsemble,
+    transforms: FeatureTransforms,
+}
+
+impl WeightModel {
+    pub fn load_from_file(path: &Path) -> io::Result<Self> {
+        let mut file = File::open(path)?;
+        let transforms = load_transforms_tail(&mut file).unwrap_or_else(|_| FeatureTransforms::disabled());
+        file.seek(SeekFrom::Start(0))?;
+        let ensemble = parse_ensemble(BufReader::new(file))?;
+        Ok(WeightModel {
+            ensemble,
+            transforms,
+        })
+    }
+
+    pub fn load_from_bytes(bytes: &[u8]) -> io::Result<Self> {
+        let tail_start = bytes.len().saturating_sub(16384);
+        let tail = String::from_utf8_lossy(bytes.get(tail_start..).unwrap_or(bytes));
+        let transforms = parse_transforms_tail(&tail).unwrap_or_else(|_| FeatureTransforms::disabled());
+        let ensemble = parse_ensemble(BufReader::new(bytes))?;
+        Ok(WeightModel {
+            ensemble,
+            transforms,
+        })
+    }
+
+    pub fn n_trees(&self) -> usize {
+        self.ensemble.n_trees()
+    }
+
+    pub fn n_features(&self) -> usize {
+        self.ensemble.n_features()
+    }
+
+    /// Predicts the quality weight for `input` scaled by `priority_factor`.
+    /// Returns `(weight, used_model)`. Falls back to `calculate_weight` if the
+    /// model returns a non-positive or NaN value, or if transforms are incompatible.
+    pub fn predict_weight(&self, input: &ModelInput, priority_factor: f64) -> (f64, bool) {
+        let total = input.success + input.failure;
+        if total < DEFAULT_MIN_SAMPLE_COUNT {
+            return (0.0, false);
+        }
+        if !self.transforms.compatible {
+            return calculate_weight(input, priority_factor);
+        }
+        let mut features = prepare_features(input);
+        let needed = self.ensemble.n_features();
+        if needed > features.len() && needed <= MAX_MODEL_FEATURE_SLOTS {
+            features.resize(needed, 0.0);
+        }
+        self.transforms.apply(&mut features);
+        let pred = self.ensemble.predict_single(&features);
+        if !pred.is_finite() || pred <= 0.0 {
+            return calculate_weight(input, priority_factor);
+        }
+        (pred * priority_factor, true)
+    }
+}
+
+fn parse_err(msg: impl Into<String>) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, msg.into())
+}
+
+fn parse_u32_list(s: &str) -> io::Result<Vec<u32>> {
+    s.split_whitespace()
+        .map(|tok| tok.parse::<u32>().map_err(|e| parse_err(e.to_string())))
+        .collect()
+}
+
+fn parse_i32_list(s: &str) -> io::Result<Vec<i32>> {
+    s.split_whitespace()
+        .map(|tok| tok.parse::<i32>().map_err(|e| parse_err(e.to_string())))
+        .collect()
+}
+
+fn parse_f64_list(s: &str) -> io::Result<Vec<f64>> {
+    s.split_whitespace()
+        .map(|tok| tok.parse::<f64>().map_err(|e| parse_err(e.to_string())))
+        .collect()
+}
+
+fn read_section<R: BufRead>(
+    reader: &mut R,
+    buf: &mut String,
+) -> io::Result<Option<HashMap<String, String>>> {
+    let mut map = HashMap::new();
+    let mut saw_any = false;
+    loop {
+        buf.clear();
+        let n = reader.read_line(buf)?;
+        if n == 0 {
+            break;
+        }
+        let line = buf.trim();
+        if line.is_empty() {
+            if saw_any {
+                break;
+            }
+            continue;
+        }
+        if line.starts_with('[') || line.starts_with("end of trees") || line.starts_with("feature_importances") || line.starts_with("parameters:") {
+            if saw_any {
+                break;
+            }
+            return Ok(None);
+        }
+        saw_any = true;
+        if let Some((k, v)) = line.split_once('=') {
+            // Only keep keys needed for header or tree inference to keep peak RAM low.
+            match k {
+                "version"
+                | "num_class"
+                | "num_tree_per_iteration"
+                | "max_feature_idx"
+                | "average_output"
+                | "Tree"
+                | "num_leaves"
+                | "num_cat"
+                | "split_feature"
+                | "threshold"
+                | "decision_type"
+                | "left_child"
+                | "right_child"
+                | "leaf_value"
+                | "cat_boundaries"
+                | "cat_threshold"
+                | "is_linear"
+                | "leaf_const"
+                | "num_features"
+                | "leaf_features"
+                | "leaf_coeff" => {
+                    map.insert(k.to_string(), v.to_string());
+                }
+                _ => {}
+            }
+        }
+    }
+    if saw_any { Ok(Some(map)) } else { Ok(None) }
+}
+
+fn parse_ensemble<R: BufRead>(mut reader: R) -> io::Result<LgbmEnsemble> {
+    let mut buf = String::with_capacity(4096);
+    // First non-empty line must be "tree".
+    loop {
+        buf.clear();
+        if reader.read_line(&mut buf)? == 0 {
+            return Err(parse_err("empty LightGBM model file"));
+        }
+        let line = buf.trim();
+        if !line.is_empty() {
+            if line != "tree" {
+                return Err(parse_err(format!("unexpected LightGBM header: {line}")));
+            }
+            break;
+        }
+    }
+
+    let header = read_section(&mut reader, &mut buf)?
+        .ok_or_else(|| parse_err("missing LightGBM header section"))?;
+    let num_class: usize = header
+        .get("num_class")
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(1);
+    if num_class != 1 {
+        return Err(parse_err(format!(
+            "unsupported LightGBM num_class={num_class} (expected 1)"
+        )));
+    }
+    let max_feature_idx: usize = header
+        .get("max_feature_idx")
+        .ok_or_else(|| parse_err("missing max_feature_idx"))?
+        .parse()
+        .map_err(|_| parse_err("invalid max_feature_idx"))?;
+    let average_output = header
+        .get("average_output")
+        .is_some_and(|v| v == "1" || v.eq_ignore_ascii_case("true"));
+
+    let mut trees = Vec::new();
+    while let Some(section) = read_section(&mut reader, &mut buf)? {
+        if !section.contains_key("Tree") {
+            if section.contains_key("num_leaves") {
+                // fallback if Tree= line was skipped
+            } else {
+                break;
+            }
+        }
+        trees.push(parse_tree(&section)?);
+    }
+    if trees.is_empty() {
+        return Err(parse_err("LightGBM model contains no trees"));
+    }
+
+    Ok(LgbmEnsemble {
+        trees: trees.into_boxed_slice(),
+        max_feature_idx,
+        average_output,
+    })
+}
+
+fn convert_missing_flags(decision_type: u32) -> io::Result<u8> {
+    match (decision_type >> 2) & 3 {
+        0 => Ok(0),
+        1 => Ok(FLAG_MISSING_ZERO),
+        2 => Ok(FLAG_MISSING_NAN),
+        other => Err(parse_err(format!("unknown missing_type={other}"))),
+    }
+}
+
+fn parse_tree(params: &HashMap<String, String>) -> io::Result<LgbmTree> {
+    let num_leaves: usize = params
+        .get("num_leaves")
+        .ok_or_else(|| parse_err("tree missing num_leaves"))?
+        .parse()
+        .map_err(|_| parse_err("invalid num_leaves"))?;
+    if num_leaves == 0 {
+        return Err(parse_err("num_leaves == 0"));
+    }
+    let num_cat: usize = params
+        .get("num_cat")
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(0);
+    let leaf_values = parse_f64_list(
+        params
+            .get("leaf_value")
+            .ok_or_else(|| parse_err("tree missing leaf_value"))?,
+    )?;
+    if leaf_values.len() != num_leaves {
+        return Err(parse_err("leaf_value length != num_leaves"));
+    }
+
+    let is_linear = params.get("is_linear").is_some_and(|v| v == "1");
+    let linear_leaves = if is_linear {
+        let leaf_consts = parse_f64_list(
+            params
+                .get("leaf_const")
+                .ok_or_else(|| parse_err("linear tree missing leaf_const"))?,
+        )?;
+        let num_features = parse_u32_list(
+            params
+                .get("num_features")
+                .ok_or_else(|| parse_err("linear tree missing num_features"))?,
+        )?;
+        if leaf_consts.len() != num_leaves || num_features.len() != num_leaves {
+            return Err(parse_err("linear tree metadata length mismatch"));
+        }
+        let total: usize = num_features.iter().map(|&n| n as usize).sum();
+        let all_feats = if total > 0 {
+            parse_u32_list(
+                params
+                    .get("leaf_features")
+                    .ok_or_else(|| parse_err("linear tree missing leaf_features"))?,
+            )?
+        } else {
+            Vec::new()
+        };
+        let all_coeffs = if total > 0 {
+            parse_f64_list(
+                params
+                    .get("leaf_coeff")
+                    .ok_or_else(|| parse_err("linear tree missing leaf_coeff"))?,
+            )?
+        } else {
+            Vec::new()
+        };
+        let mut leaves = Vec::with_capacity(num_leaves);
+        let mut off = 0usize;
+        for (&constant, &nf_u32) in leaf_consts.iter().zip(num_features.iter()) {
+            let nf = nf_u32 as usize;
+            let feat_slice = all_feats
+                .get(off..off + nf)
+                .ok_or_else(|| parse_err("linear leaf_features out of bounds"))?;
+            let coeff_slice = all_coeffs
+                .get(off..off + nf)
+                .ok_or_else(|| parse_err("linear leaf_coeff out of bounds"))?;
+            let feats: Box<[u16]> = feat_slice
+                .iter()
+                .map(|&f| u16::try_from(f).unwrap_or(u16::MAX))
+                .collect();
+            let coeffs: Box<[f64]> = coeff_slice.into();
+            off += nf;
+            leaves.push(LinearLeaf {
+                constant,
+                features: feats,
+                coeffs,
+            });
+        }
+        Some(leaves.into_boxed_slice())
+    } else {
+        None
+    };
+
+    if num_leaves == 1 {
+        return Ok(LgbmTree {
+            nodes: Box::new([]),
+            leaf_values: leaf_values.into_boxed_slice(),
+            cat_boundaries: Box::new([]),
+            cat_thresholds: Box::new([]),
+            linear_leaves,
+        });
+    }
+
+    let num_nodes = num_leaves - 1;
+    let left_child = parse_i32_list(
+        params
+            .get("left_child")
+            .ok_or_else(|| parse_err("tree missing left_child"))?,
+    )?;
+    let right_child = parse_i32_list(
+        params
+            .get("right_child")
+            .ok_or_else(|| parse_err("tree missing right_child"))?,
+    )?;
+    let decision_type = parse_u32_list(
+        params
+            .get("decision_type")
+            .ok_or_else(|| parse_err("tree missing decision_type"))?,
+    )?;
+    let split_feature = parse_u32_list(
+        params
+            .get("split_feature")
+            .ok_or_else(|| parse_err("tree missing split_feature"))?,
+    )?;
+    let threshold = parse_f64_list(
+        params
+            .get("threshold")
+            .ok_or_else(|| parse_err("tree missing threshold"))?,
+    )?;
+    if left_child.len() != num_nodes
+        || right_child.len() != num_nodes
+        || decision_type.len() != num_nodes
+        || split_feature.len() != num_nodes
+        || threshold.len() != num_nodes
+    {
+        return Err(parse_err("tree internal arrays length != num_leaves - 1"));
+    }
+
+    let raw_cat_thresholds = if num_cat > 0 {
+        parse_u32_list(
+            params
+                .get("cat_threshold")
+                .ok_or_else(|| parse_err("tree missing cat_threshold"))?,
+        )?
+    } else {
+        Vec::new()
+    };
+    let raw_cat_boundaries = if num_cat > 0 {
+        parse_u32_list(
+            params
+                .get("cat_boundaries")
+                .ok_or_else(|| parse_err("tree missing cat_boundaries"))?,
+        )?
+    } else {
+        Vec::new()
+    };
+
+    let mut cat_boundaries = if num_cat > 0 { vec![0u32] } else { Vec::new() };
+    let mut cat_thresholds = Vec::new();
+    let mut nodes = Vec::with_capacity(num_nodes);
+
+    for idx in 0..num_nodes {
+        let dt = *decision_type
+            .get(idx)
+            .ok_or_else(|| parse_err("decision_type out of range"))?;
+        let raw_feat = *split_feature
+            .get(idx)
+            .ok_or_else(|| parse_err("split_feature out of range"))?;
+        let raw_thresh = *threshold
+            .get(idx)
+            .ok_or_else(|| parse_err("threshold out of range"))?;
+        let raw_left = *left_child
+            .get(idx)
+            .ok_or_else(|| parse_err("left_child out of range"))?;
+        let raw_right = *right_child
+            .get(idx)
+            .ok_or_else(|| parse_err("right_child out of range"))?;
+        let mut flags = convert_missing_flags(dt)?;
+        let feat = u16::try_from(raw_feat)
+            .map_err(|_| parse_err("split_feature exceeds u16"))?;
+        let thresh = if dt & 1 != 0 {
+            flags |= FLAG_CATEGORICAL;
+            let cat_idx = raw_thresh as usize;
+            let start = *raw_cat_boundaries
+                .get(cat_idx)
+                .ok_or_else(|| parse_err("cat_boundaries out of range"))?
+                as usize;
+            let end = *raw_cat_boundaries
+                .get(cat_idx + 1)
+                .ok_or_else(|| parse_err("cat_boundaries end out of range"))?
+                as usize;
+            let slice = raw_cat_thresholds
+                .get(start..end)
+                .ok_or_else(|| parse_err("cat_threshold slice out of range"))?;
+            let n_bits: u32 = slice.iter().map(|w| w.count_ones()).sum();
+            if n_bits == 0 {
+                return Err(parse_err("empty categorical bitset"));
+            } else if n_bits == 1 {
+                let mut bit_pos = 0u32;
+                for (wi, &w) in slice.iter().enumerate() {
+                    if w != 0 {
+                        bit_pos = (wi as u32) * 32 + w.trailing_zeros();
+                        break;
+                    }
+                }
+                flags |= FLAG_CAT_ONE_HOT;
+                f64::from(bit_pos)
+            } else if let [single] = slice {
+                flags |= FLAG_CAT_SMALL;
+                f64::from(*single)
+            } else {
+                let new_idx = (cat_boundaries.len() - 1) as u32;
+                cat_thresholds.extend_from_slice(slice);
+                cat_boundaries.push(cat_thresholds.len() as u32);
+                f64::from(new_idx)
+            }
+        } else {
+            if dt & (1 << 1) != 0 {
+                flags |= FLAG_DEFAULT_LEFT;
+            }
+            raw_thresh
+        };
+
+        let left = if raw_left < 0 {
+            flags |= FLAG_LEFT_LEAF;
+            (!raw_left) as u32
+        } else {
+            raw_left as u32
+        };
+        let right = if raw_right < 0 {
+            flags |= FLAG_RIGHT_LEAF;
+            (!raw_right) as u32
+        } else {
+            raw_right as u32
+        };
+        nodes.push(LgbmNode {
+            threshold: thresh,
+            left,
+            right,
+            feature: feat,
+            flags,
+        });
+    }
+
+    Ok(LgbmTree {
+        nodes: nodes.into_boxed_slice(),
+        leaf_values: leaf_values.into_boxed_slice(),
+        cat_boundaries: cat_boundaries.into_boxed_slice(),
+        cat_thresholds: cat_thresholds.into_boxed_slice(),
+        linear_leaves,
+    })
+}
