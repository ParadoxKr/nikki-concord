+fn extract_ip_feature(ip_str: &str) -> i32 {
+    let Ok(addr) = ip_str.parse::<IpAddr>() else {
+        return 0;
+    };
+    match addr {
+        IpAddr::V4(v4) => {
+            let [a, b, c, _] = v4.octets();
+            if a == 10 || (a == 172 && (16..=31).contains(&b)) || (a == 192 && b == 168) {
+                10
+            } else if a == 127 {
+                11
+            } else if a == 169 && b == 254 {
+                12
+            } else if (a == 100 && (64..=127).contains(&b))
+                || (a == 192 && b == 0 && c == 2)
+                || (a == 198 && b == 51 && c == 100)
+                || (a == 203 && b == 0 && c == 113)
+                || a >= 240
+            {
+                13
+            } else {
+                14
+            }
+        }
+        IpAddr::V6(v6) => {
+            if v6 == Ipv6Addr::LOCALHOST {
+                11
+            } else {
+                let [seg0, seg1, ..] = v6.segments();
+                if (seg0 & 0xffc0) == 0xfe80 {
+                    12
+                } else if (seg0 & 0xfe00) == 0xfc00 {
+                    10
+                } else if (seg0 == 0x2001 && seg1 == 0x0db8) || (seg0 & 0xff00) == 0xff00 {
+                    13
+                } else if let Some(v4) = v6.to_ipv4_mapped() {
+                    extract_ip_feature(&Ipv4Addr::from(v4.octets()).to_string())
+                } else {
+                    15
+                }
+            }
+        }
+    }
+}
