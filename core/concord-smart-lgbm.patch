+    fn sync_smart_model(
+        &self,
+        home: &Arc<HomeDir>,
+        general: &concord_config::general::General,
+        outbounds: &Arc<Outbounds>,
+        stop: CancellationToken,
+    ) {
+        if !outbounds.has_smart_lightgbm() {
+            return;
+        }
+        if let Some(existing) = self.shared.smart_model.load_full() {
+            outbounds.set_smart_model(Some(existing));
+        }
+        if self
+            .shared
+            .smart_model_loading
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return;
+        }
+        let home = home.clone();
+        let outbounds = outbounds.clone();
+        let smart_model = self.shared.smart_model.clone();
+        let loading = self.shared.smart_model_loading.clone();
+        let fetcher = self.shared.fetcher.clone();
+        let auto_update = general.lgbm_auto_update;
+        let interval_hours = u64::from(general.lgbm_update_interval.max(1));
+        let url = if general.lgbm_url.is_empty() {
+            concord_group::DEFAULT_LGBM_URL.to_string()
+        } else {
+            general.lgbm_url.clone()
+        };
+
+        self.tasks.spawn(async move {
+            struct ClearGuard(Arc<AtomicBool>);
+            impl Drop for ClearGuard {
+                fn drop(&mut self) {
+                    self.0.store(false, Ordering::Release);
+                }
+            }
+            let _guard = ClearGuard(loading);
+            let model_path = home.root().join("Model.bin");
+
+            let mut need_download = !model_path.is_file();
+            if !need_download && smart_model.load().is_none() {
+                let p = model_path.clone();
+                match tokio::task::spawn_blocking(move || concord_group::WeightModel::load_from_file(&p)).await {
+                    Ok(Ok(model)) => {
+                        let model = Arc::new(model);
+                        tracing::info!(
+                            "[Smart] Loaded LightGBM Model.bin ({} trees, {} features)",
+                            model.n_trees(),
+                            model.n_features()
+                        );
+                        smart_model.store(Some(model.clone()));
+                        outbounds.set_smart_model(Some(model));
+                        concord_platform::release_free_memory();
+                    }
+                    Ok(Err(err)) => {
+                        tracing::warn!("[Smart] Invalid Model.bin ({err}), will re-download");
+                        need_download = true;
+                    }
+                    Err(err) => {
+                        tracing::warn!("[Smart] Model.bin loader task failed: {err}");
+                        return;
+                    }
+                }
+            }
+
+            if !need_download && auto_update {
+                if let Ok(meta) = std::fs::metadata(&model_path)
+                    && let Ok(modified) = meta.modified()
+                    && let Ok(age) = std::time::SystemTime::now().duration_since(modified)
+                    && age >= Duration::from_secs(interval_hours.saturating_mul(3600))
+                {
+                    need_download = true;
+                }
+            }
+
+            if !need_download || stop.is_cancelled() {
+                return;
+            }
+
+            tracing::info!("[Smart] Downloading LightGBM Model.bin from {url}");
+            let req = concord_group::FetchRequest {
+                url,
+                headers: Vec::new(),
+                via_proxy: None,
+                size_limit: Some(64 << 20),
+                timeout: Duration::from_secs(120),
+            };
+            let spilled = tokio::select! {
+                () = stop.cancelled() => return,
+                res = crate::resources::download_spilled(fetcher.as_ref(), req, home.root()) => match res {
+                    Ok(spilled) => spilled,
+                    Err(err) => {
+                        tracing::warn!("[Smart] Failed to download Model.bin: {err}");
+                        return;
+                    }
+                }
+            };
+            let home_for_store = home.clone();
+            let parsed = tokio::task::spawn_blocking(move || -> std::io::Result<concord_group::WeightModel> {
+                let mapped = spilled.bytes()?;
+                let model = concord_group::WeightModel::load_from_bytes(&mapped)?;
+                drop(mapped);
+                spilled.store(&home_for_store, "Model.bin")?;
+                Ok(model)
+            })
+            .await;
+
+            match parsed {
+                Ok(Ok(model)) => {
+                    let model = Arc::new(model);
+                    tracing::info!(
+                        "[Smart] Downloaded and loaded LightGBM Model.bin ({} trees, {} features)",
+                        model.n_trees(),
+                        model.n_features()
+                    );
+                    smart_model.store(Some(model.clone()));
+                    outbounds.set_smart_model(Some(model));
+                    concord_platform::release_free_memory();
+                }
+                Ok(Err(err)) => {
+                    tracing::warn!("[Smart] Downloaded Model.bin rejected: {err}");
+                }
+                Err(err) => {
+                    tracing::warn!("[Smart] Model.bin parse task failed: {err}");
+                }
+            }
+        });
+    }
