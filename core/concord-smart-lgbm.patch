+fn extract_asn_feature(asn_info: &str) -> i32 {
+    if asn_info.is_empty() {
+        return 0;
+    }
+    let lower = asn_info.to_ascii_lowercase();
+    for &(kw, cat) in ASN_CATEGORIES {
+        if lower.contains(kw) {
+            return cat;
+        }
+    }
+    let s = lower.strip_prefix("as").unwrap_or(&lower);
+    let digits = s
+        .as_bytes()
+        .iter()
+        .take_while(|b| b.is_ascii_digit())
+        .count();
+    if let Some(prefix) = s.get(..digits)
+        && digits > 0
+        && let Ok(num) = prefix.parse::<u64>()
+    {
+        return if num < 1000 {
+            1
+        } else if num < 10000 {
+            2
+        } else if num < 50000 {
+            3
+        } else if num < 150000 {
+            4
+        } else {
+            5
+        };
+    }
+    0
+}
