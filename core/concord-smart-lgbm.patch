+/// Heuristic fallback matching `vernesong/mihomo`'s `smart.CalculateWeight`.
+pub fn calculate_weight(input: &ModelInput, priority_factor: f64) -> (f64, bool) {
+    let total = input.success + input.failure;
+    if total < DEFAULT_MIN_SAMPLE_COUNT {
+        return (0.0, false);
+    }
+
+    let scene = identify_scene(
+        input.is_udp,
+        input.latency_ms,
+        input.upload_mb,
+        input.download_mb,
+        input.max_upload_rate_kb,
+        input.max_download_rate_kb,
+        input.duration_minutes,
+    );
+    let mut params = scene.params();
+    let time_factor = if input.last_used_unix > 0 {
+        time_decay(input.last_used_unix, now_unix_secs(), params.min_decay_factor)
+    } else {
+        1.0
+    };
+
+    let mut decayed_s = (input.success as f64) * time_factor;
+    let mut decayed_f = (input.failure as f64) * time_factor;
+    let mut decayed_total = decayed_s + decayed_f;
+    if decayed_total < 1.0 {
+        decayed_s = decayed_s.max(0.5);
+        decayed_f = decayed_f.max(0.5);
+        decayed_total = decayed_s + decayed_f;
+    }
+
+    let connect_time = if input.connect_time_ms == 0 {
+        if input.connection_failed { 2000 } else { 1 }
+    } else {
+        input.connect_time_ms
+    };
+    let latency = if input.latency_ms == 0 {
+        if input.connection_failed { 2000 } else { 1 }
+    } else {
+        input.latency_ms
+    };
+
+    let success_rate = decayed_s / decayed_total;
+    let connect_score = ((-(connect_time as f64) / 1500.0).exp() * time_factor).clamp(0.3, 0.8);
+    let latency_score = ((-(latency as f64) / 1500.0).exp() * time_factor).clamp(0.3, 0.8);
+
+    if input.is_udp {
+        params.latency_weight = (params.latency_weight * 1.2).min(0.5);
+        params.success_rate_weight = (params.success_rate_weight * 1.1).min(0.6);
+        params.connect_time_weight = 1.0 - params.success_rate_weight - params.latency_weight;
+    }
+
+    let is_short = input.duration_minutes <= 1.0;
+    let is_long = input.duration_minutes > 10.0;
+    let base_weight = success_rate * params.success_rate_weight
+        + connect_score * params.connect_time_weight
+        + latency_score * params.latency_weight;
+
+    let tf = if input.upload_mb > 0.0 || input.download_mb > 0.0 {
+        let up = traffic_factor(
+            input.upload_mb,
+            input.max_upload_rate_kb,
+            input.duration_minutes,
+            input.history_max_upload_rate_kb,
+            input.history_upload_mb,
+            input.history_duration_minutes,
+            is_short,
+        );
+        let dl = traffic_factor(
+            input.download_mb,
+            input.max_download_rate_kb,
+            input.duration_minutes,
+            input.history_max_download_rate_kb,
+            input.history_download_mb,
+            input.history_duration_minutes,
+            is_short,
+        );
+        let (uw, dw) = if scene == Scene::Streaming {
+            (0.2, 0.8)
+        } else if scene == Scene::Transfer && input.upload_mb > input.download_mb * 2.0 {
+            (0.7, 0.3)
+        } else {
+            (0.4, 0.6)
+        };
+        up * uw + dl * dw
+    } else {
+        0.0
+    };
+
+    let duration_factor = if input.duration_minutes > 0.0 {
+        if is_short {
+            (0.1 + input.duration_minutes.ln_1p() * 0.08).min(0.3)
+        } else if is_long {
+            (0.2 + input.duration_minutes.ln_1p() * 0.1).min(0.5)
+        } else {
+            (0.15 + input.duration_minutes.ln_1p() * 0.09).min(0.4)
+        }
+    } else {
+        0.1
+    };
+
+    let mut quality_bonus = 0.0f64;
+    if latency > 0 && latency < 100 {
+        quality_bonus += 0.1;
+    }
+    if connect_time > 0 && connect_time < 10 {
+        quality_bonus += 0.1;
+    }
+    if matches!(scene, Scene::Streaming | Scene::Transfer) && input.download_mb > 20.0 {
+        quality_bonus += 0.1;
+    }
+    if scene == Scene::Interactive && latency > 0 && latency < 100 && success_rate > 0.9 {
+        quality_bonus += 0.1;
+    }
+    quality_bonus = quality_bonus.min(0.3);
+
+    let loss_factor = if input.loss_rate > 0.0 || input.cumul_loss_rate > 0.0 {
+        let cur = if input.loss_rate > 0.0 {
+            1.0 - (-input.loss_rate * 10.0).exp()
+        } else {
+            0.0
+        };
+        let cum = if input.cumul_loss_rate > 0.0 {
+            1.0 - (-input.cumul_loss_rate * 50.0).exp()
+        } else {
+            0.0
+        };
+        let ema = if input.ema_loss_rate > 0.0 {
+            1.0 - (-input.ema_loss_rate * 50.0).exp()
+        } else {
+            0.0
+        };
+        let trust = (cum * 5.0).min(1.0);
+        let improve = if cum > 0.0 && ema > 0.0 && ema < cum {
+            ema / cum
+        } else {
+            1.0
+        };
+        trust * cur.max(cum) * improve + (1.0 - trust) * cur * 0.3
+    } else {
+        0.0
+    };
+
+    let w = base_weight
+        * (1.0 + tf * params.traffic_weight + duration_factor * params.duration_weight
+            + quality_bonus * params.quality_weight
+            - loss_factor * params.loss_weight)
+        * priority_factor;
+    (w, false)
+}
