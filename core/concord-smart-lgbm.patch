+fn geo_category(code: &str) -> Option<i32> {
+    Some(match code {
+        "CN" => 100, "HK" => 101, "TW" => 102, "JP" => 103, "KR" => 104,
+        "SG" => 105, "US" => 106, "CA" => 107, "GB" => 108, "DE" => 109,
+        "FR" => 110, "RU" => 111, "AU" => 112, "IN" => 113, "BR" => 114,
+        "IT" => 115, "ES" => 116, "NL" => 117, "SE" => 118, "CH" => 119,
