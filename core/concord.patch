new file mode 100644
index 0000000..d726941
--- /dev/null
+++ b/crates/rules/src/activity.rs
@@ -0,0 +1,109 @@
+use std::ops::Range;
+use std::sync::atomic::{AtomicBool, AtomicI64, AtomicU64, Ordering::Relaxed};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct RuleActivity {
+    pub disabled: bool,
+    pub hit_count: u64,
+    pub hit_at: i64,
+    pub miss_count: u64,
+    pub miss_at: i64,
+}
+
+#[derive(Default)]
+struct Counter {
+    count: AtomicU64,
+    at: AtomicI64,
+}
+
+impl Counter {
+    fn note(&self, at: i64) {
+        self.at.fetch_max(at, Relaxed);
+        self.count.fetch_add(1, Relaxed);
+    }
+}
+
+#[derive(Default)]
+struct Activity {
+    disabled: AtomicBool,
+    hit: Counter,
+    miss: Counter,
+}
+
+pub(crate) struct Activities {
+    rules: Box<[Activity]>,
+    disabling_used: AtomicBool,
+}
+
+impl Activities {
+    pub(crate) fn new(len: usize) -> Self {
+        Self {
+            rules: (0..len).map(|_| Activity::default()).collect(),
+            disabling_used: AtomicBool::new(false),
+        }
+    }
+
+    pub(crate) fn heap_bytes(&self) -> usize {
+        std::mem::size_of_val(&*self.rules)
+    }
+
+    pub(crate) fn snapshot(&self, index: usize) -> RuleActivity {
+        self.rules
+            .get(index)
+            .map_or_else(RuleActivity::default, |rule| RuleActivity {
+                disabled: rule.disabled.load(Relaxed),
+                hit_count: rule.hit.count.load(Relaxed),
+                hit_at: rule.hit.at.load(Relaxed),
+                miss_count: rule.miss.count.load(Relaxed),
+                miss_at: rule.miss.at.load(Relaxed),
+            })
+    }
+
+    pub(crate) fn set_disabled(&self, index: usize, disabled: bool) -> bool {
+        let Some(rule) = self.rules.get(index) else {
+            return false;
+        };
+        if disabled {
+            self.disabling_used.store(true, Relaxed);
+        }
+        rule.disabled.swap(disabled, Relaxed) != disabled
+    }
+
+    pub(crate) fn disabled(&self, index: u32) -> bool {
+        self.rules
+            .get(index as usize)
+            .is_some_and(|rule| rule.disabled.load(Relaxed))
+    }
+
+    pub(crate) fn any_enabled(&self, range: Range<u32>) -> bool {
+        !range.is_empty()
+            && (!self.disabling_used.load(Relaxed)
+                || range.into_iter().any(|idx| !self.disabled(idx)))
+    }
+
+    pub(crate) fn hit(&self, index: u32) {
+        if let Some(rule) = self.rules.get(index as usize) {
+            rule.hit.note(now());
+        }
+    }
+
+    pub(crate) fn miss(&self, range: Range<u32>) {
+        let mut at = None;
+        if let Some(rules) = self.rules.get(range.start as usize..range.end as usize) {
+            for rule in rules {
+                if !rule.disabled.load(Relaxed) {
+                    rule.miss.note(*at.get_or_insert_with(now));
+                }
+            }
+        }
+    }
+}
+
+fn now() -> i64 {
+    let millis = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis();
+    i64::try_from(millis).unwrap_or(i64::MAX)
+}
