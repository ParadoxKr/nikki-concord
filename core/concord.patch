+fn indexed<'p>(
+    activities: Option<&Activities>,
+    from: u32,
+    end: u32,
+    mut find: impl FnMut(u32) -> Option<u32>,
+) -> Outcome<'p> {
+    let mut start = from;
+    let matched = loop {
+        match find(start) {
+            Some(index) if activities.is_some_and(|activity| activity.disabled(index)) => {
+                start = index + 1;
+            }
+            matched => break matched,
+        }
+    };
+    if let Some(activity) = activities {
+        activity.miss(from..matched.unwrap_or(end));
+        if let Some(index) = matched {
+            activity.hit(index);
+        }
+    }
+    match matched {
+        Some(idx) => Outcome::Candidate {
+            idx,
+            advance: Advance::Pos(idx + 1),
+        },
