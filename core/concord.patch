+            .await
+            .status,
+        204
+    );
+    assert!(connect().await);
+    let rules = rig.call("GET", "/rules", None).await.json();
+    assert_eq!(rules["rules"][1]["extra"]["disabled"], true);
+    assert_eq!(rules["rules"][1]["extra"]["hitCount"], 1);
+    assert_eq!(rules["rules"][1]["extra"]["missCount"], 0);
+    assert_eq!(rules["rules"][2]["extra"]["hitCount"], 1);
+    assert_eq!(
+        rig.call("PATCH", "/rules/disable", Some(json!({ "1": false })))
+            .await
+            .status,
+        204
+    );
+    assert!(!connect().await);
+    let rules = rig.call("GET", "/rules", None).await.json();
+    assert_eq!(rules["rules"][1]["extra"]["disabled"], false);
+    assert_eq!(rules["rules"][1]["extra"]["hitCount"], 2);
+    assert_eq!(rules["rules"][2]["extra"]["hitCount"], 1);
+    serve.await.unwrap();
+    rig.control.shutdown().await;
+}
